# cryptochain-backend-sandbox — TESTNET / SANDBOX ONLY
# Copy this file to .env.sandbox and replace placeholders.
# Do not put real production secrets, mainnet RPC URLs, or production DB URIs here.

NODE_ENV=sandbox
PORT=4100

# Hard requirement. The process refuses to start if this is not "sepolia".
NETWORK=sepolia
SEPOLIA_CHAIN_ID=11155111

# Public Sepolia JSON-RPC. The URL MUST include "sepolia".
# Mainnet hosts and URLs containing "mainnet" are rejected at startup.
# Examples (no API key required):
#   https://ethereum-sepolia-rpc.publicnode.com
#   https://rpc.sepolia.org
#   https://1rpc.io/sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Watch-only Sepolia address that receives sandbox payments (test ETH only).
# Replace with your own Sepolia account. Do not use a mainnet-funded wallet.
SANDBOX_SEPOLIA_RECEIVE_ADDRESS=0x000000000000000000000000000000000000dEaD

# Local SQLite file for sandbox rows only. The path MUST contain "sandbox".
# Production DATABASE_URL / MongoDB URIs are rejected at startup.
SANDBOX_SQLITE_PATH=./db/data/sandbox.sqlite

# Placeholder sandbox secrets — generate local values; never commit real keys.
SANDBOX_API_KEY=sk_sandbox_replace_me
SANDBOX_WEBHOOK_SECRET=whsec_sandbox_replace_me

# Confirmations required on Sepolia before an order is marked confirmed.
SEPOLIA_REQUIRED_CONFIRMATIONS=2

# Optional CORS allowlist (comma-separated). Localhost is always allowed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
