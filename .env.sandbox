# CryptoChain sandbox environment (Sepolia testnet + Stripe test mode)
# These are placeholders / throwaway values. Replace RPC and Stripe keys with your own test credentials.

DATABASE_URL=postgresql://cryptochain:cryptochain@localhost:5433/cryptochain_sandbox

# Free Sepolia JSON-RPC. Swap in Alchemy or Infura if you hit rate limits:
#   https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
#   https://sepolia.infura.io/v3/YOUR_KEY
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Throwaway test wallet key generated for this sandbox. It has never held real funds.
# Do not reuse this key on mainnet. Rotate it if you ever fund it on Sepolia.
SEPOLIA_PRIVATE_KEY=0xe2e495a30f85661a44f619e3bd6e4a91b407435e18d4caa6d1d1ec7315f23640

STRIPE_TEST_SECRET_KEY=sk_test_replace_me
STRIPE_TEST_WEBHOOK_SECRET=whsec_replace_me

# Comma-separated origins for the Flutter app (and local web tooling).
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

REQUIRED_CONFIRMATIONS=3
PAYMENT_TOLERANCE_PERCENT=1
WATCHER_POLL_INTERVAL_MS=15000

PORT=4000
NODE_ENV=sandbox

# Server-side cap (ETH). Sandbox tests use small amounts well under this.
MAX_TRANSACTION_AMOUNT=1
PAYMENTS_ENABLED=true
