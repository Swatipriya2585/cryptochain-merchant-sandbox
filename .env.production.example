# =============================================================================
# DO NOT populate this until the go-live checklist is signed off
# See /infra/CUTOVER_CHECKLIST.md
# =============================================================================
#
# This file mirrors sandbox keys with mainnet / Stripe live names.
# Leave every value empty until cutover is approved. Never copy .env.sandbox
# values here — especially SEPOLIA_PRIVATE_KEY (sandbox throwaway wallets).

# Production Postgres (empty until cutover)
DATABASE_URL=

# Ethereum mainnet JSON-RPC (replaces SEPOLIA_RPC_URL)
MAINNET_RPC_URL=

# Dedicated mainnet signer — never the sandbox throwaway key
SEPOLIA_PRIVATE_KEY=

# Stripe live secret (replaces STRIPE_TEST_SECRET_KEY)
STRIPE_LIVE_SECRET_KEY=

STRIPE_TEST_WEBHOOK_SECRET=

CORS_ORIGIN=

PORT=4000
NODE_ENV=production
