# =============================================================================
# Production environment template
# =============================================================================
# DO NOT populate this until /infra/CUTOVER_CHECKLIST.md is signed off.
# Copy to a secrets manager (or a gitignored `.env.production`) and fill blanks
# yourself. Never commit real values. Never paste a private key into chat.
#
# Do not copy `.env.sandbox`. Especially not SEPOLIA_PRIVATE_KEY.
# =============================================================================

NODE_ENV=production
PORT=4000

# Production Postgres — not localhost:5433 / cryptochain_sandbox
DATABASE_URL=

# Dedicated Ethereum mainnet HTTPS JSON-RPC (Alchemy, Infura, etc.)
# Must NOT contain "sepolia" or "testnet". Example shape only:
#   https://eth-mainnet.g.alchemy.com/v2/<YOUR_KEY>
MAINNET_RPC_URL=

# Dedicated mainnet signer. Load from a secrets manager.
# Leave blank here. Do not generate, commit, or paste a key.
MAINNET_PRIVATE_KEY=

# Stripe LIVE keys — sk_live_… / live-mode webhook signing secret.
# Test keys (sk_test_ / STRIPE_TEST_*) are rejected at boot.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# Comma-separated browser origins for the merchant app
CORS_ORIGIN=

# Mainnet defaults (sandbox uses 3 / 1 / 15000). Raise confirmations, keep the cap small.
REQUIRED_CONFIRMATIONS=12
PAYMENT_TOLERANCE_PERCENT=1
WATCHER_POLL_INTERVAL_MS=15000

# Hard server-side cap in ETH. The frontend value is untrusted.
# An early production bug cannot create an intent above this amount.
MAX_TRANSACTION_AMOUNT=0.05

# Kill switch. Leave false until cutover is signed off and you are ready
# to accept live payments. Set false again to halt new intents without a deploy.
PAYMENTS_ENABLED=false

# Slack incoming webhook (hooks.slack.com) or Discord webhook (discord.com/api/webhooks).
# Fired on payout FAILED and repeated merchant-webhook delivery failures.
ALERT_WEBHOOK_URL=
