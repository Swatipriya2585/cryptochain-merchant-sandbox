{
  "name": "cryptochain-sandbox-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CryptoChain sandbox backend — Node.js, TypeScript, Express. Sepolia and Stripe test mode only.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/prisma-generate.cjs && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "postinstall": "node scripts/prisma-generate.cjs",
    "prisma:generate": "node scripts/prisma-generate.cjs",
    "sandbox:fund": "tsx src/blockchain/faucet-helper.ts",
    "pretest": "node scripts/prisma-db-push.cjs",
    "prisma:push": "node scripts/prisma-db-push.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "pino": "^9.11.0",
    "pino-pretty": "^13.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
